    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /PointCloud21
        - /MarkerArray1/Topic1
        - /MarkerArray3/Topic1
        - /Marker1/Topic1
        - /Localization Map (Autoware)1
