        - /EKF Pose1
        - /Image1
        - /Image1/Topic1
        - /Image2
        - /Image2/Topic1
        - /Path2
      Splitter Ratio: 0.5
    Tree Height: 742
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
