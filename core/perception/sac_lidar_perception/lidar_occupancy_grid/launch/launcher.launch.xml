<launch version="0.1.0">
  <node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="static_tf_pub_lidar"
    args="0.0 0.0 0.0 -0.25 0.0 0.0 base_link velodyne"
  />
  <node
    pkg="lidar_occupancy_grid"
    exec="lidar_occupancy_grid"
    name="lidar_to_occupancy_grid"
    output="screen"
  >
    <param name="grid_resolution" value="0.3"/>                 
    <param name="grid_size" value="243"/>                        
    <param name="MinProbability" value="0.1"/>                  
    <param name="MaxProbability" value="0.95"/>                 
    <param name="frame_id" value="ego_vehicle"/>
  </node>

  <node
    pkg="ground_segmentation"
    exec="travel_ground_filter_node"
    name="ground_filter"
    output="screen"
  >
    <param from="$(find-pkg-share ground_segmentation)/config/ground_segmentation.param.yaml"/>
  </node>

  <node
    pkg="object_clustering"
    exec="travel_object_clustering_node"
    name="object_clustering"
    output="screen"
  >
    <param from="$(find-pkg-share object_clustering)/config/object_clustering.param.yaml"/>
  </node>
</launch>